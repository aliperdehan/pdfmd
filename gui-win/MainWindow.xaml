<Window x:Class="ColophonWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Colophon" Width="1320" Height="840" MinWidth="720" MinHeight="480"
        WindowStartupLocation="Manual" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource ForegroundBrush}" Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition x:Name="SplitterRow" Height="0" />
      <RowDefinition x:Name="PaneRow" Height="0" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="10,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="OpenButton" Content="Open Folder" Click="OpenFolder_Click" ToolTip="Open a folder (Ctrl+O)" />
          <Button x:Name="BuildButton" Content="Build" Click="Build_Click" ToolTip="Build the open file (Ctrl+B)" />
        </StackPanel>
        <TextBlock x:Name="ProjectLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <wv2:WebView2 x:Name="Web" Grid.Row="1" />

    <GridSplitter x:Name="BuildSplitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                  Background="{DynamicResource BorderBrush}" Visibility="Collapsed"
                  ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

    <Border x:Name="BuildPane" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="8,4,8,2">
          <Button x:Name="PdfTab" Style="{StaticResource PaneTab}" Content="PDF" Click="PdfTab_Click" />
          <Button x:Name="LogTab" Style="{StaticResource PaneTab}" Content="Log" Click="LogTab_Click" />
          <Button DockPanel.Dock="Right" Style="{StaticResource PaneTab}" Content="Close" Click="ClosePane_Click" />
          <TextBlock x:Name="PaneTitle" Margin="8,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid Grid.Row="1">
          <wv2:WebView2 x:Name="PdfWeb" Visibility="Collapsed" />
          <TextBox x:Name="LogText" IsReadOnly="True" Visibility="Collapsed" BorderThickness="0,1,0,0"
                   FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,4">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="Ready." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StateText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
